<?xml version='1.0' encoding='utf-8'?>
<widget id="org.webosarchive.papyrus" android-versionCode="214" version="1.6.1" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Papyrus</name>
    <description>Papyrus eReader - an open-source ePub reader, from webOS to Android</description>
    <author email="curator@webosarchive.org" href="https://github.com/codepoet80/webos-papyrus-ereader">
        webOS Archive
    </author>
    <icon src="www/icon-256.png" />
    <content src="index.html" />

    <!-- No allow-navigation entries on purpose: the app is single-page and never
         needs the WebView itself to leave http://localhost. Anything that tries
         (Discuss in Claude's window.open, mailto: from Share Page) then falls
         through to allow-intent and opens in the system browser / mail app
         instead of replacing Papyrus inside the WebView. XHR (sync, dictionary)
         is governed by <access> and the page CSP, not by allow-navigation. -->
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="mailto:*" />
    <access origin="*" />

    <!-- http://localhost, so the dictionary proxy (http on webOS-era hosts) and
         user WebDAV servers on plain http aren't blocked as mixed content. -->
    <preference name="Scheme" value="http" />
    <preference name="BackgroundColor" value="0xff2c1a0e" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="AndroidWindowSplashScreenBackground" value="#2c1a0e" />
        <!-- Android 12+ splash masks this to a circle covering the middle 2/3,
             so the square icon is pre-shrunk onto a 768px canvas to fit inside it
             (resources/android/splash.png, made from app/icons/512.png). Without
             this preference Cordova shows its own default robot icon. -->
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/splash.png" />
        <edit-config file="AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
    </platform>
</widget>
